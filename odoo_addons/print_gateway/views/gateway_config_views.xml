<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_config_list" model="ir.ui.view">
        <field name="name">print_gateway.gateway_config.list</field>
        <field name="model">print_gateway.gateway_config</field>
        <field name="arch" type="xml">
            <list string="Connection &amp; Printing" create="1" class="o_pg_list">
                <field name="company_id" string="Company"/>
                <field name="last_test_status"
                       string="Connection"
                       widget="badge"
                       decoration-success="last_test_status == 'success'"
                       decoration-danger="last_test_status in ('failed', 'revoked')"
                       decoration-muted="last_test_status == 'draft'"/>
                <field name="enabled" widget="boolean_toggle" string="Printing"/>
                <field name="gateway_url"/>
            </list>
        </field>
    </record>

    <record id="view_print_gateway_config_form" model="ir.ui.view">
        <field name="name">print_gateway.gateway_config.form</field>
        <field name="model">print_gateway.gateway_config</field>
        <field name="arch" type="xml">
            <form string="Connection" create="1" class="o_pg_view o_pg_form">
                <header>
                    <button name="action_test_connection" type="object" string="Check connection" class="oe_highlight"/>
                    <field name="gateway_sync_state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1>Connect Yaseir</h1></div>
                    <div class="alert alert-info" role="status" invisible="not gateway_sync_message"><field name="gateway_sync_message" readonly="1" nolabel="1"/></div>
                    <group string="Connection details">
                        <field name="company_id" string="Company"/>
                        <field name="gateway_url" string="Connection address" placeholder="https://print.example.com"/>
                        <field name="gateway_api_key" string="Connection key" password="True" placeholder="Copy the key from Connect Odoo in Yaseir"/>
                        <field name="last_test_status" string="Connection" widget="badge" readonly="1"
                               decoration-success="last_test_status == 'success'" decoration-danger="last_test_status in ('failed', 'revoked')"/>
                    </group>
                    <details class="mb-3">
                        <summary>Connection help</summary>
                        <p class="text-muted">Use the Odoo connection key from Connect Odoo in Yaseir. The Windows computer pairing code is different.</p>
                    </details>
                    <group string="Next steps">
                        <div class="d-flex flex-wrap gap-2">
                            <button name="action_open_printers" type="object" string="View printers" class="btn btn-outline-primary"/>
                            <button name="action_open_destinations" type="object" string="Document Destinations" class="btn btn-outline-primary"/>
                        </div>
                    </group>
                    <group string="Printing">
                        <field name="enabled" widget="boolean_toggle" string="Enable printing"/>
                        <details class="mb-2">
                            <summary>When can printing start?</summary>
                            <p class="text-muted">Check the connection, assign a computer to the branch, and choose a verified printer for the document before enabling printing.</p>
                        </details>
                    </group>
                    <notebook>
                        <page string="Advanced connection settings">
                            <group><field name="last_test_at" readonly="1"/><field name="last_enabled_sync_at" readonly="1"/></group>
                            <div class="d-flex flex-wrap gap-2">
                                <button name="action_retry_enabled_sync" type="object" string="Retry Synchronization" class="btn btn-secondary"/>
                                <button name="action_open_runtime_assignments" type="object" string="Manage branch computers" class="btn btn-secondary"/>
                                <button name="action_reset_stale_sync_state" type="object" string="Recover Stale Synchronization" class="btn btn-outline-warning" confirm="Recover synchronization state only after checking the previous Gateway endpoint."/>
                            </div>
                            <p class="text-muted mt-3">Recovery is for an administrator resolving a previous connection. It does not reprint documents.</p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_print_gateway_config_search" model="ir.ui.view">
        <field name="name">print_gateway.gateway_config.search</field>
        <field name="model">print_gateway.gateway_config</field>
        <field name="arch" type="xml">
            <search string="Connection &amp; Printing">
                <field name="company_id"/>
                <field name="gateway_url"/>
                <field name="last_test_status"/>
                <field name="enabled"/>
                <filter string="Connected" name="filter_connected" domain="[('last_test_status','=','success')]"/>
                <filter string="Not connected" name="filter_not_connected" domain="[('last_test_status','=','failed')]"/>
                <filter string="API key revoked" name="filter_revoked" domain="[('last_test_status','=','revoked')]"/>
                <filter string="Not checked" name="filter_not_checked" domain="[('last_test_status','=','draft')]"/>
                <separator/>
                <filter string="Printing enabled" name="filter_enabled" domain="[('enabled','=',True)]"/>
                <filter string="Printing disabled" name="filter_disabled" domain="[('enabled','=',False)]"/>
                <separator/>
                <filter string="Company" name="group_company" context="{'group_by':'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_print_gateway_config" model="ir.actions.act_window">
        <field name="name">Connection</field>
        <field name="res_model">print_gateway.gateway_config</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_print_gateway_config_search"/>
    </record>

    <record id="view_print_gateway_pair_agent_wizard_form" model="ir.ui.view">
        <field name="name">print_gateway.pair_agent_wizard.form</field>
        <field name="model">print_gateway.pair_agent_wizard</field>
        <field name="arch" type="xml">
            <form string="Connect Print Agent" class="o_pg_view o_pg_pairing_wizard">
                <sheet>
                    <div class="o_pg_wizard_header text-center mb-4">
                        <i class="fa fa-plug fa-3x text-primary mb-2" title="Connect Agent" role="img" aria-label="Connect Agent" t-translation="on"/>
                        <h3 class="fw-bold">Connect Print Agent</h3>
                        <p class="text-muted">Select the branch and choose an available Print Agent. A branch can use more than one agent.</p>
                    </div>
                    <group>
                        <field name="config_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="branch_id" string="Branch" options="{'no_create': True, 'no_open': True}"/>
                        <field name="agent_id" string="Print Agent" widget="gateway_runtime_agent_picker" placeholder="Select a connected Print Agent" class="o_pg_pairing_code_input" required="1" help="Choose a connected Print Agent for this branch."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_pairing" string="Connect Agent" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <template id="diagnostic_report">
        <t t-call="web.html_container">
            <t t-set="diagnostic_body">
                <div class="page" t-att-class="'page o_pg_diagnostic_ticket' if paper_width_mm else 'page'" t-att-dir="'rtl' if env.context.get('lang', '').startswith('ar') else 'ltr'">
                    <h1>Yaseir Print Gateway</h1>
                    <h2>Printer Test Page</h2>
                    <p><strong t-translation="on">Company:</strong> <span t-esc="company_name"/></p>
                    <p><strong t-translation="on">Location:</strong> <span t-esc="branch_name"/></p>
                    <p><strong t-translation="on">Printer:</strong> <span t-esc="printer_name"/></p>
                    <p><strong t-translation="on">Time:</strong> <span t-esc="now_str"/></p>
                    <p>This page tests document rendering. Inspect the physical printer to confirm output.</p>
                </div>
            </t>
            <!-- Odoo rebuilds each article with its UTF-8/report asset wrapper.
                 A bare page drops that wrapper and corrupts Unicode in wkhtmltopdf. -->
            <div t-if="paper_width_mm" class="article" t-att-data-oe-lang="env.lang">
                <style>
                    .o_pg_diagnostic_ticket { font-size: 8pt; line-height: 1.15; word-break: normal; }
                    .o_pg_diagnostic_ticket span { overflow-wrap: break-word; word-wrap: break-word; }
                    .o_pg_diagnostic_ticket h1 { font-size: 11pt; line-height: 1.15; margin: 0 0 1mm; }
                    .o_pg_diagnostic_ticket h2 { font-size: 10pt; line-height: 1.15; margin: 0 0 2mm; }
                    .o_pg_diagnostic_ticket p { margin: 0 0 1mm; }
                </style>
                <t t-out="diagnostic_body"/>
            </div>
            <t t-else="" t-call="web.external_layout"><t t-out="diagnostic_body"/></t>
        </t>
    </template>
    <record id="action_diagnostic_report" model="ir.actions.report">
        <field name="name">Printer Test Page</field>
        <field name="model">print_gateway.binding</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">print_gateway.diagnostic_report</field>
    </record>
</odoo>
