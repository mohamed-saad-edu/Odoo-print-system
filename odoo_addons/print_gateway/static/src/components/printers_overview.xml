<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="print_gateway.PrintersOverview">
        <main class="o_pg_view o_pg_inventory p-3 p-md-4 overflow-auto h-100">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                <div><h1>Printers</h1><p class="text-muted mb-0">Choose a verified printer, then select its documents.</p></div>
                <div class="d-flex flex-wrap gap-2"><button type="button" class="btn btn-outline-secondary" t-on-click="mappings" t-att-disabled="!scope || scope.assignable === false">Document Destinations</button><button type="button" class="btn btn-outline-primary" t-on-click="refresh" t-att-disabled="state.loading">Refresh</button></div>
            </div>
            <div class="row g-3 mb-4" t-if="assignableScopes.length">
                <div class="col-md-6">
                    <label t-if="showScopeSelector" for="pg_inventory_scope" class="form-label">Company or branch</label>
                    <label t-else="" class="form-label">Company or branch</label>
                    <select t-if="showScopeSelector" id="pg_inventory_scope" class="form-select" t-on-change="changeScope" t-att-value="state.scopeId">
                        <option value="0" disabled="disabled" t-att-selected="state.scopeId === 0">Choose a company or branch</option>
                        <option t-foreach="state.scopes" t-as="scope" t-key="scope.id" t-att-selected="scope.id === state.scopeId" t-att-disabled="scope.assignable === false" t-att-value="scope.id" t-esc="scope.label"/>
                    </select>
                    <div t-else="" class="form-control bg-light" role="status"><bdi t-esc="scope.label"/></div>
                </div>
                <div t-if="state.agents.length > 1" class="col-md-6">
                    <label for="pg_inventory_agent" class="form-label">Printing computer</label>
                    <select id="pg_inventory_agent" class="form-select" t-on-change="changeAgent" t-att-value="state.agentId" t-att-disabled="state.loading">
                        <option value="" t-att-selected="!state.agentId">Select a computer</option>
                        <option t-foreach="state.agents" t-as="agent" t-key="agent.id" t-att-selected="agent.id === state.agentId" t-att-value="agent.id" t-esc="agent.name"/>
                    </select>
                </div>
                <div t-elif="state.agents.length === 1" class="col-md-6">
                    <label class="form-label">Printing computer</label>
                    <div class="form-control bg-light"><bdi t-esc="state.agents[0].name"/></div>
                </div>
            </div>
            <div t-if="state.error" class="alert alert-warning" role="alert"><t t-esc="state.error"/></div>
            <div t-if="!state.loading &amp;&amp; agentIsOffline" role="status" class="alert alert-warning">The selected printing computer is offline or its status is outdated. Check the Windows printing app before relying on printer availability.</div>
            <p t-if="state.loading" role="status">Checking available printers…</p>
            <div t-elif="!scope" class="card p-4 text-center"><p>Choose a company or branch</p></div>
            <div t-elif="scope &amp;&amp; !scope.configId" class="card p-4 text-center">
                <h2>Connect Yaseir</h2>
                <p>Connect once, choose your printer, and enable the documents your business needs.</p>
                <div><button type="button" class="btn btn-primary" t-on-click="connect">Connect Yaseir</button></div>
            </div>
            <div t-elif="state.error" class="card p-4 text-center"><button type="button" class="btn btn-outline-primary" t-on-click="refresh">Retry</button></div>
            <div t-elif="!state.agents.length" class="card p-4 text-center">
                <h2 t-if="state.agentEmptyReason === 'unassigned'">No computer assigned to this company or branch</h2>
                <h2 t-elif="state.agentEmptyReason === 'not_registered'">No active printing computer found</h2>
                <h2 t-elif="state.agentEmptyReason === 'connection'">Printing service is not connected</h2>
                <h2 t-else="">Assigned printing computer is unavailable</h2>
                <p t-if="state.agentEmptyReason === 'unassigned'">Choose an existing Yaseir Print Agent for this exact company or branch.</p>
                <p t-elif="state.agentEmptyReason === 'not_registered'">Open and pair the Windows printing app in Yaseir, then refresh.</p>
                <p t-elif="state.agentEmptyReason === 'connection'">Check the company connection before selecting a printing computer.</p>
                <p t-else="">Check the assigned Agent in Yaseir. Inactive or removed Agents cannot provide printers.</p>
                <div><button type="button" class="btn btn-primary" t-if="state.agentEmptyReason !== 'connection'" t-on-click="assignments">Manage branch computers</button><button type="button" class="btn btn-primary" t-else="" t-on-click="connect">Check connection</button></div>
            </div>
            <div t-elif="state.agentId &amp;&amp; !state.printers.length" class="card p-4">
                <h2>No verified printers available</h2>
                <p class="mb-0">Open the Windows printing app, discover the printer, verify it and enable sharing. Then refresh this page.</p>
            </div>
            <div t-elif="state.agentId" class="row g-3">
                <div t-foreach="state.printers" t-as="printer" t-key="printer.id" class="col-md-6 col-xl-4">
                    <section class="card h-100 p-3">
                        <div class="d-flex justify-content-between align-items-start gap-2"><h2 class="h5"><bdi t-esc="printer.name"/></h2><span class="badge rounded-pill" t-att-class="isReady(printer) ? 'text-bg-success' : 'text-bg-warning'" t-esc="status(printer)"/></div>
                        <p t-if="printer.outputMedium === 'file'" class="text-muted">Verified PDF file output</p>
                        <p t-else="" class="text-muted">Physical printer</p>
                        <button type="button" class="btn btn-primary mt-auto" t-att-disabled="!isReady(printer)" t-on-click="() => this.choose(printer)">Choose documents for this printer</button>
                    </section>
                </div>
            </div>
            <details class="mt-4" t-if="scope &amp;&amp; scope.assignable !== false"><summary>Manage branch computers</summary><p class="text-muted mt-2">Computer assignments control which Agents can serve this company or branch. Changing an assignment does not create a print destination.</p><button type="button" class="btn btn-outline-secondary" t-on-click="assignments">Branch Devices</button></details>
        </main>
    </t>
</templates>
