{
  "name": "yaseir-gateway",
  "version": "1.0.0",
  "description": "Yaseir \u2014 Cloud Printing Platform (Next.js + PostgreSQL + Drizzle), Windows Go agent, and Tauri desktop manager",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=12.2.1"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint . && oxlint --threads 2 -c .oxlintrc.json .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "tsx scripts/db-generate.ts",
    "db:studio": "drizzle-kit studio",
    "desktop:vite:build": "vite build --config vite.desktop.config.mts",
    "desktop:build": "npm run desktop:vite:build && pwsh -File scripts/build-windows-installer.ps1",
    "desktop:dev": "vite --config vite.desktop.config.mts",
    "desktop:linux:deps": "bash scripts/setup-tauri-linux.sh --check",
    "desktop:linux:deps:install": "bash scripts/setup-tauri-linux.sh --install",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:coverage": "vitest run --config vitest.unit.config.mts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "vitest run --config vitest.integration.config.mts --run tests/e2e-job-flow.test.ts",
    "test:odoo:static": "pytest tests/test_odoo19_printing_static.py",
    "build": "next build --webpack",
    "db:provision-plans": "tsx scripts/provision-plans.ts",
    "platform:bootstrap": "tsx scripts/bootstrap-platform-owner.ts",
    "db:docs:check": "python3 scripts/check-db-docs.py",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "i18n:odoo:check": "python3 scripts/check-odoo-translations.py",
    "typography:check": "python3 scripts/check-typography-tokens.py"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "drizzle-orm": "0.45.4",
    "get-nonce": "1.0.1",
    "gsap": "3.15.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "ws": "8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/api": "2.12.4",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "react-style-singleton": "2.2.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5",
    "@next/eslint-plugin-next": "16.4.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "oxlint": "1.88.0"
  },
  "overrides": {
    "brace-expansion@1.x": "1.1.21",
    "brace-expansion@5.x": "5.0.12",
    "esbuild": "0.28.2",
    "source-map-js": "1.2.2",
    "undici": "8.12.2",
    "sharp": "0.35.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  },
  "packageManager": "npm@12.2.1"
}
