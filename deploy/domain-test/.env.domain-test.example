# HTTPS domain staging configuration for the test branch.
POSTGRES_DB=yasser_http_test
POSTGRES_USER=yasser_test
POSTGRES_PASSWORD=generated-at-setup
GATEWAY_JWT_SECRET=generated-at-setup
TRUST_PROXY_SECRET=generated-at-setup
PLATFORM_TENANT_ID=http-test-platform
MANAGER_USERNAME=http-test-admin
# Setup binds the domain automatically; set only to select among multiple workspaces.
MANAGER_TENANT_ID=
MANAGER_PASSWORD_HASH=unused-in-https-staging
GATEWAY_DOMAIN=print.yaseir.cloud
APP_BASE_URL=https://print.yaseir.cloud
COOKIE_SECURE=1
TRUST_PROXY=1
# Enables fake Stripe plans and email capture, never insecure transport/auth.
YASEIR_STAGING_FIXTURES_ENABLED=1
YASEIR_STAGING_SINGLE_WORKSPACE=1
# Only for this HTTPS staging stack; production remains explicitly opt-in.
YASEIR_E2E_CAPTURE_ENABLED=1
STAGING_PG_VOLUME=http-test_postgres_http_test_data
STRIPE_PLAN_CATALOG=[{"id":"http-test","name":"Staging Trial","priceId":"price_http_test_yasser","currency":"usd","interval":"month","entitlements":{"max_agents":5,"max_printers":10,"max_jobs_per_minute":60,"max_concurrent_jobs":8,"max_prints_per_period":"unlimited"}},{"id":"go","name":"Go","priceId":"price_go_yasser","currency":"usd","interval":"month","entitlements":{"max_agents":10,"max_printers":10,"max_jobs_per_minute":120,"max_concurrent_jobs":20,"max_prints_per_period":"unlimited"}}]
