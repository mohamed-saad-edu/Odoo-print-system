# Existing HTTPS staging only. Never substitute a production volume.
POSTGRES_DB=yasser_http_test
POSTGRES_USER=yasser_test
POSTGRES_PASSWORD=generated-at-setup
POSTGRES_OWNER_USER=yaseir_owner
POSTGRES_OWNER_PASSWORD=generated-at-setup
POSTGRES_RUNTIME_USER=yaseir_runtime
POSTGRES_RUNTIME_PASSWORD=generated-at-setup
GATEWAY_JWT_SECRET=generated-at-setup
TRUST_PROXY_SECRET=generated-at-setup
MANAGER_USERNAME=http-test-admin
MANAGER_TENANT_ID=
MANAGER_PASSWORD_HASH=unused-in-https-staging
PLATFORM_TENANT_ID=http-test-platform
GATEWAY_DOMAIN=print.yaseir.cloud
APP_BASE_URL=https://print.yaseir.cloud
COOKIE_SECURE=1
TRUST_PROXY=1
YASEIR_STAGING_FIXTURES_ENABLED=1
YASEIR_STAGING_SINGLE_WORKSPACE=1
STAGING_PG_VOLUME=http-test_postgres_http_test_data
STAGING_ROLE_STATE_VOLUME=yaseir_domain_test_role_state
# V4 is manual billing. These bootstrap PLANS never activate subscriptions.
YASEIR_PLAN_CATALOG=[{"id":"http-test","name":"Staging Manual","description":"Staging-only plan; owner activation required","monthlyQuota":1000},{"id":"go","name":"Go","description":"Staging manual plan","monthlyQuota":2000}]
# Optional real transactional mail; when absent, exact staging captures links.
RESEND_API_KEY=
EMAIL_FROM=
