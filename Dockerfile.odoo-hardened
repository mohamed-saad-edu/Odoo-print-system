    && test "$(dpkg-query -W -f='${Version}' python3-pdfminer)" = '20221105+dfsg-1' \
    && dpkg --purge python3-pip python3-wheel python3-pdfminer \
    && for package in python3-pip python3-wheel python3-pdfminer; do \
         if dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then \
           echo "Unexpected installed runtime package: $package" >&2; exit 1; \
         fi; \
       done \
    && python3 -c 'import importlib.util as u; assert u.find_spec("pip") is None; assert u.find_spec("pdfminer") is None' \
